pipeline {
    agent any

    environment {
        BRANCH_NAME = "jenkins-job"
    }

    stages {
        stage('Test') {
            steps {
                echo "Testing the application on branch ${BRANCH_NAME}"
            }
        }

        stage('Build') {
            steps {
                echo "Building the application..."
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying from ${BRANCH_NAME}"
            }
        }
    }
}
